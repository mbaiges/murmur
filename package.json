{
  "name": "murmur",
  "version": "0.1.0",
  "main": "./out/main/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node scripts/run-dev.mjs",
    "build": "electron-vite build",
    "generate:brand": "node scripts/generate-brand-icons.mjs",
    "verify:brand": "node scripts/verify-brand-icons.mjs",
    "sync:renderer-public": "node scripts/sync-renderer-public.mjs",
    "postinstall": "electron-builder install-app-deps",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder",
    "test": "vitest run tests/unit",
    "test:watch": "vitest tests/unit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:structured-phrase-generation": "playwright test tests/e2e/magazine-layouts.spec.ts tests/e2e/structured-phrase-generation.spec.ts",
    "test:e2e:structured-layout-semantics": "playwright test tests/e2e/structured-layout-semantics.spec.ts",
    "test:e2e:magazine-layouts-editorial": "playwright test tests/e2e/magazine-layouts-editorial.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "vitest run && playwright test",
    "lint": "eslint src",
    "test:e2e:repo-restructure": "playwright test tests/e2e/murmur.spec.ts",
    "test:e2e:settings-ui-reorg": "playwright test tests/e2e/settings-ui-reorg.spec.ts",
    "test:e2e:style-voice-settings-polish": "playwright test tests/e2e/style-voice-settings-polish.spec.ts",
    "test:e2e:per-monitor-settings": "playwright test tests/e2e/per-monitor-settings.spec.ts",
    "test:e2e:brand-assets": "playwright test tests/e2e/brand-assets.spec.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "canvas": "^3.1.0",
    "dotenv": "^17.2.3",
    "fast-xml-parser": "^5.10.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "^0.33.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^20.14.9",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "electron-playwright-helpers": "^1.7.1",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "esbuild": "0.25.0",
    "tar": "7.5.16"
  },
  "build": {
    "appId": "com.mbaiges.murmur",
    "productName": "Murmur",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "asInvoker",
      "icon": "resources/icon.png"
    },
    "mac": {
      "icon": "resources/icon.png",
      "category": "public.app-category.utilities"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "asarUnpack": [
      "**/node_modules/sharp/**/*",
      "**/node_modules/@img/**/*",
      "**/node_modules/canvas/**/*"
    ]
  }
}
